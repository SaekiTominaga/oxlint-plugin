{
	"name": "oxlint-plugin",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"prelint": "npm run build --workspaces",
		"lint": "conc --raw \"npm run lint:js\" \"npm run lint:package\"",
		"lint:js": "oxlint",
		"lint:package": "conc --raw \"publint packages/safely-storage\"",
		"test": "npm run test --workspaces"
	},
	"dependencies": {
		"@oxlint/plugins": "1.80.0"
	},
	"devDependencies": {
		"@types/node": "26.3.0",
		"@w0s/tsconfig": "3.1.1",
		"concurrently": "10.0.5",
		"oxfmt": "0.65.0",
		"oxlint": "1.80.0",
		"oxlint-tsgolint": "7.0.2001",
		"publint": "0.3.24",
		"rimraf": "6.1.3",
		"typescript": "7.0.2"
	}
}
